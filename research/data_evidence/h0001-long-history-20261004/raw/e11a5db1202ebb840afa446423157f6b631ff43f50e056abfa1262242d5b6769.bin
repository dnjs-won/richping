gin"},{"type":"paragraph","text":"\u003ca href=\"https://support.twelvedata.com/en/articles/5745849-timezones\"\u003eTimezones\u003c/a\u003e","class":"no-margin"},{"type":"paragraph","text":"\u003ca href=\"https://support.twelvedata.com/en/articles/6487105-how-do-i-upgrade-my-subscription\"\u003eUpgrading your subscription \u003c/a\u003e","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"}],"collectionId":"15873164","description":"Use extended-hours market data to cover pre-market and after-hours sessions","id":"4710373","lastUpdated":"Updated over 9 months ago","lastUpdatedDate":"2026-01-12T11:36:52Z","markdown":null,"relatedArticles":null,"targetUserType":"everyone","title":"Pre/Post-market data","showTableOfContents":false,"synced":false,"isStandaloneApp":false},"breadcrumbs":[{"url":"https://support.twelvedata.com/en/collections/2999522-guides","name":"Guides"},{"url":"https://support.twelvedata.com/en/collections/15873164-data-usage","name":"Data usage "}],"selectedReaction":null,"showReactions":true,"themeCSSCustomProperties":{"--body-bg":"rgb(255, 255, 255)","--body-image":"none","--body-bg-rgb":"255, 255, 255","--body-border":"rgb(230, 230, 230)","--body-primary-color":"#1a1a1a","--body-secondary-color":"#595959","--body-reaction-bg":"rgb(242, 242, 242)","--body-reaction-text-color":"rgb(89, 89, 89)","--body-toc-active-border":"#737373","--body-toc-inactive-border":"#f2f2f2","--body-toc-inactive-color":"#595959","--body-toc-active-font-weight":400,"--body-table-border":"rgb(204, 204, 204)","--body-color":"hsl(0, 0%, 0%)","--footer-bg":"rgb(255, 255, 255)","--footer-image":"none","--footer-border":"rgb(230, 230, 230)","--footer-color":"hsl(211, 10%, 61%)","--header-bg":"rgb(29, 29, 31)","--header-image":"url(https://downloads.intercomcdn.com/i/o/305830/4721ffcd3f837b38493cd6eb/63c6f557d155c8318456641b5852945a.png)","--header-color":"hsl(0, 0%, 100%)","--collection-card-bg":"rgb(255, 255, 255)","--collection-card-image":"none","--collectio