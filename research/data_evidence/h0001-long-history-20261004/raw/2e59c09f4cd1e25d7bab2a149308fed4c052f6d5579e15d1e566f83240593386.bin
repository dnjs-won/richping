,\"/_next/static/chunks/00iejqt0h7je5.js\",\"/_next/static/chunks/1l_kf-b785-l2.js\",\"/_next/static/chunks/1tzg8zeu6njpm.js\",\"/_next/static/chunks/2xlwk1v1vdoq_.js\",\"/_next/static/chunks/1p5qfrvdsbgi3.js\",\"/_next/static/chunks/0rzl-lji_h2r-.js\",\"/_next/static/chunks/2kdrd6cynfufo.js\"],\"Tag\"]\n87:I[27201,[\"/_next/static/chunks/1n1mr41qbk_ao.js\",\"/_next/static/chunks/0c32ti5fgr4yr.js\"],\"IconMark\"]\n50:[\"$\",\"$4\",null,{\"fallback\":[\"$\",\"div\",null,{\"role\":\"status\",\"className\":\"flex justify-center my-16 w-full items-center\",\"children\":[[\"$\",\"svg\",null,{\"aria-hidden\":\"true\",\"className\":\"size-10 animate-spin fill-accent text-gray-200 dark:text-gray-600 mr-2\",\"viewBox\":\"0 0 100 101\",\"fill\":\"none\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z\",\"fill\":\"currentColor\"}],[\"$\",\"path\",null,{\"d\":\"M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z\",\"fill\":\"currentFill\"}]]}],[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"Loading...\"}]]}],\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is Massive's stock data adjusted for splits or dividends?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Aggregate bars are split-adjusted by default, and you get raw prices with adjusted=false. Nothing is dividend-adjusted, and tick-level trades and quotes are never adjusted at all, so they always show the price that printed.\\\"}}]}\"}}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-6 py-4 lg:px-8\",\"children\":[[\"$\",\"$L9\",\"knowledge-base\",{\"href\":\"https://massive.com/knowledge-base\",\"className\":\"mr-2 space-x-2 text-sm font-medium text-gray-900 capitalize hover:text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Knowledge Base\"}],[\"$\",\"span\",null,{\"className\":\"text-gray-500\",\"children\":\"/\"}]]}],[\"$\",\"span\",\"knowledge-base/article/is-massives-stock-data-adjusted-for-splits-or-dividends\",{\"className\":\"text-sm font-medium text-gray-500\",\"children\":\"Is Massive's stock data adjusted for splits or dividends?\"}]]}],[\"$\",\"hr\",null,{}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-6 lg:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl pt-20 pb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex max-w-4xl flex-col gap-6\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-4xl font-bold text-gray-900\",\"children\":\"Is Massive's stock data adjusted for splits or dividends?\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4\",\"children\":[[\"$\",\"$L6d\",\"Stocks\",{\"tag\":{\"icon\":\"$undefined\",\"label\":\"Stocks\",\"value\":\"stocks\"},\"tagUrl\":\"https://massive.com/knowledge-base/categories/stocks\"}],[\"$\",\"$L6d\",\"FAQ\",{\"tag\":{\"icon\":\"$undefined\",\"label\":\"FAQ\",\"value\":\"faq\"},\"tagUrl\":\"https://massive.com/knowledge-base/categories/faq\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xl font-normal text-gray-600\",\"dangerouslySetInnerHTML\":{\"__html\":\"Aggregate bars are split-adjusted by default, and you get raw prices with adjusted=false. Nothing is dividend-adjusted, and tick-level trades and quotes are never adjusted at all, so they always show the price that printed.\"}}]]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose prose-gray max-w-none\",\"children\":[\"$\",\"article\",null,{\"children\":[\"$L6e\",\"$L6f\",\"$L70\",\"$L71\",\"$L72\",\"$L73\",\"$L74\",\"$L75\",\"$L76\",\"$L77\",\"$L78\",\"$L79\",\"$L7a\",\"$L7b\",\"$L7c\",\"$L7d\",\"$L7e\",\"$L7f\",\"$L80\",\"$L81\",\"$L82\",\"$L83\"]}]}]}],\"$L84\"]}],\"$L85\",\"$L86\"]}]]}]}]\n52:null\n56:[[\"$\",\"title\",\"0\",{\"children\":\"Is Massive's stock data adjusted for splits or dividends? | Massive\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Which Massive data is split-adjusted, how to get unadjusted prices, and why dividend adjustment is not offered.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://massive.com/knowledge-base/article/is-massives-stock-data-adjusted-for-splits-or-dividends\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"Is Massive's stock data adjusted for splits or dividends? | Massive\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:description\",\"content\":\"Which Massive data is split-adjusted, how to get unadjusted prices, and why dividend adjustment is not offered.\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:image\",\"content\":\"https://massive.com/brands/logo-massive.jpg\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:title\",\"content\":\"Is Massive's stock data adjusted for splits or dividends? | Massive\"}],[\"$\"