efined\",\"style\":{},\"children\":[\", \"]}],[\"$\",\"span\",\"code-segment-9\",{\"className\":\"$undefined\",\"style\":{\"color\":\"#d19a66\"},\"children\":[\"\\\"results\\\"\"]}],[\"$\",\"span\",\"code-segment-10\",{\"className\":\"$undefined\",\"style\":{},\"children\":[\": [{ \"]}],[\"$\",\"span\",\"code-segment-11\",{\"className\":\"$undefined\",\"style\":{\"color\":\"#d19a66\"},\"children\":[\"\\\"c\\\"\"]}],[\"$\",\"span\",\"code-segment-12\",{\"className\":\"$undefined\",\"style\":{},\"children\":[\": \"]}],[\"$\",\"span\",\"code-segment-13\",{\"className\":\"$undefined\",\"style\":{\"color\":\"#d19a66\"},\"children\":[\"1209.98\"]}],[\"$\",\"span\",\"code-segment-14\",{\"className\":\"$undefined\",\"style\":{},\"children\":[\" }], \"]}],[\"$\",\"span\",\"code-segment-15\",{\"className\":\"$undefined\",\"style\":{\"color\":\"#d19a66\"},\"children\":[\"\\\"status\\\"\"]}],[\"$\",\"span\",\"code-segment-16\",{\"className\":\"$undefined\",\"style\":{},\"children\":[\": \"]}],[\"$\",\"span\",\"code-segment-17\",{\"className\":\"$undefined\",\"style\":{\"color\":\"#98c379\"},\"children\":[\"\\\"OK\\\"\"]}],[\"$\",\"span\",\"code-segment-18\",{\"className\":\"$undefined\",\"style\":{},\"children\":[\" }\\n\"]}],\"\"]]}]}],[\"$\",\"div\",null,{\"className\":\"absolute right-6 bottom-4\",\"children\":[\"$\",\"$L88\",null,{\"text\":\"{ \\\"ticker\\\": \\\"NVDA\\\", \\\"adjusted\\\": false, \\\"results\\\": [{ \\\"c\\\": 1209.98 }], \\\"status\\\": \\\"OK\\\" }\\n\"}]}]]}]]\n78:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"The same request with no parameter returns \",[\"$\",\"span\",null,{\"className\":\"dark:prose-invert rounded-md bg-gray-100 p-1 font-mono text-sm dark:bg-gray-800\",\"children\":\"\\\"adjusted\\\": true\"}],\" and a close of 120.998, because\",\" \",\"NVDA split ten for one on 10 June 2024. The \",[\"$\",\"span\",null,{\"className\":\"dark:prose-invert rounded-md bg-gray-100 p-1 font-mono text-sm dark:bg-gray-800\",\"children\":\"adjusted\"}],\" field in the envelope always tells you\",\" \",\"which version you received, so read it rather than assuming.\"]}]\n79:[\"$\",\"h2\",null,{\"className\":\"[text-wrap:balance] text-2xl/8 font-bold text-gray-900 sm:text-3xl/9 sm:tracking-tight\",\"children\":\"Which one to store\"}]\n7a:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"Store the unadjusted prices if you are keeping a permanent record. An adjusted series is\",\" \",\"computed against today's share count, so it changes retroactively every time the company splits\",\" \",\"again: the history you downloaded last year no longer matches the history you download today,\",\" \",\"and nothing in your data will tell you it moved. Storing raw prices plus the split records from\",\" \",[\"$\",\"span\",null,{\"className\":\"dark:prose-invert rounded-md bg-gray-100 p-1 font-mono text-sm dark:bg-gray-800\",\"children\":\"/stocks/v1/splits\"}],\" lets you rebuild any adjusted view you need and keeps the stored numbers\",\" \",\"stable.\"]}]\n7b:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"Use the adjusted default when you are charting or computing returns across a split and do not\",\" \",\"intend to keep the result.\"]}]\n7c:[\"$\",\"h2\",null,{\"className\":\"[text-wrap:balance] text-2xl/8 font-bold text-gray-900 sm:text-3xl/9 sm:tracking-tight\",\"children\":\"Why there is no dividend adjustment\"}]\n7d:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"There is no dividend-adjusted series because a dividend adjustment is a modeling choice rather\",\" \",\"than a fact. It depends on whether you assume dividends are reinvested, at what price, and\",\" \",\"whether you net out withholding tax, and different vendors answer those differently, which is\",\" \",\"why two dividend-adjusted series of the same stock rarely agree. Massive publishes the raw\",\" \",\"prices and the dividend records, so you can apply whichever convention your work requires.\"]}]\n7e:[\"$\",\"h2\",null,{\"className\":\"[text-wrap:balance] text-2xl/8 font-bold text-gray-900 sm:text-3xl/9 sm:tracking-tight\",\"children\":\"If you see an error\"}]\n7f:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"A price series with a step on one date, and no news to explain it, is almost always an\",\" \",\"unadjusted series crossing a split. Check \",[\"$\",\"span\",null,{\"className\":\"dark:prose-invert rounded-md bg-gray-100 p-1 font-mono text-sm dark:bg-gray-800\",\"children\":\"/stocks/v1/splits\"}],\" for an \",[\"$\",\"span\",null,{\"className\":\"dark:prose-invert rounded-md bg-gray-100 p-1 font-mono text-sm dark:bg-gray-800\",\"children\":\"execution_date\"}],\" near\",\" \",\"the step.\"]}]\n80:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"Bars that disagree with a broker statement are usually the adjustment. Ask for\",\" \",[\"$\",\"span\",null,{\"className\":\"dark:prose-invert rounded-md bg-gray-100 p-1 font-mono text-sm dark:bg-gray-800\",\"children\":\"adjusted=false\"}],\" and compare again.\"]}]\n81:[\"$\",\"p\",null,{\"className\":\"font-sans text-[#4B5563] font-normal text-base leading-6\",\"children\":[\"Trades that disagree with an adjusted bar are expected: the trades are raw. That is not a data\",\" \",\"error.\"]}]\n82:[\"$\",\"h2\",null,{\"className\":\"[text-wrap:balance] text-2xl/8 font-bold text-gray-900 sm:text-3xl/9 sm:tracking-tight\",\"children\":\"Related\"}]\n83:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L9\",null,{\"href\":\"/knowledge-base/article/does-massive-adjust-historic-dividends-for-splits\",\"children\":\"Does Massive adjust historic dividends for splits?\",\"className\":\"text