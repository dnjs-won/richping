        <script src="/build/js/app.js?id=18254a5a056f75a3863361ca39ee151b" defer></script>
    
        <script>
    document.addEventListener('DOMContentLoaded', () => {
        (function ($) {
            const symbol   = $('.stats-tag-list__symbol');
            const arrow = $('.stats-tag-list__symbol svg');
            const menu  = $('#exchangesMenu');
            let   items = menu.find('[role="menuitem"]');

            function isOpen(){
                return menu.attr('data-open') === 'true';
            }
            function setOpen(val){
                if (val) {
                    menu.attr('data-open', 'true');
                    symbol.attr('aria-expanded', 'true');
                    arrow.css("transform", "rotate(180deg)")
                } else {
                    menu.removeAttr('data-open');
                    symbol.attr('aria-expanded', 'false');
                    arrow.css("transform", "rotate(0deg)")
                }
            }

            function openMenu(){
                setOpen(true);
                $(document).on('mousedown.menu', onDocClick);
                $(document).on('keydown.menu', onGlobalKey);
            }

            function closeMenu(){
                setOpen(false);
                symbol.trigger('focus');
                $(document).off('mousedown.menu', onDocClick);
                $(document).off('keydown.menu', onGlobalKey);
            }

            symbol.on('click', function(){
                isOpen() ? closeMenu() : openMenu();
                if (isOpen() === true) {
                    menu.data('perfectScrollbar').update();
                }
            });

            function onDocClick(e){
                const target = $(e.target);
                if (!target.closest(menu).length && !target.closest(symbol).length){
                    closeMenu();
                }
            }

            function onGlobalKey(e){
                if (e.key === 'Escape') {
                    closeMenu();
                    return;
                }
                if (!isOpen()) {
                    return;
                }

                const active = document.activeElement;
                const idx = items.index(active);

                if (e.key === 'ArrowDown'){
                    e.preventDefault();
                    const next = (idx + 1) % items.length;
                    items.eq(next).trigger('focus');
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    const prev = (idx - 1 + items.length) % items.length;
                    items.eq(prev).trigger('focus');
                }
            }

            symbol.on('keydown', function(e){
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    isOpen() ? closeMenu() : openMenu();
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (!isOpen()) {
                        openMenu();
                    };
                }
            });
        })(jQuery);
    });
</script>
