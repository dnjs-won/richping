            <button type="button" class="cookie-consent__close" aria-label="Close" data-cookie-close>
    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg></button>

            <h2 id="cookie-consent-settings-title" class="cookie-consent__title">Cookie Settings</h2>

            <div class="cookie-consent__modal-body">
                <p class="cookie-consent__text cookie-consent__text--lg">
                    Click the headings below to learn more about each category of cookies and adjust your preferences. See                                            <a href="https://twelvedata.com/cookies">our Cookie Policy</a> for details.                                    </p>

                <form id="cookie-consent-configure" action="https://twelvedata.com/cookie-consent/configure" method="post" data-cookie-action="accept.configuration">
                    <input type="hidden" name="_token" value="EfrA6FvXpK577HtqRw5LI0uw1W8YbrJtJTVa7AWW" autocomplete="off">                                                                    <div class="cookie-consent__category cookie-consent__category--collapsed" data-cookie-category>
                            <div class="cookie-consent__category-head">
                                <button type="button" class="cookie-consent__category-toggle" aria-expanded="false" aria-controls="cookie-consent-description-essentials" data-cookie-accordion>
                                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18 15L12 9L6 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>                                    <span>Strictly necessary</span>
                                </button>

                                                                    
                                    <input type="hidden" name="categories[]" value="essentials">
                                    <span class="cookie-consent__always-on">Always on</span>
                                                            </div>

                                                            <div id="cookie-consent-description-essentials" class="cookie-consent__category-body">
                                    <div>
                                        <p class="cookie-consent__category-text">These cookies are essential for the operation, security, and integrity of our website and services. They enable core functionality such as authentication, session management, and security protections.</p>
                                    </div>
                                </div>
                                                    </div>
                                                                    <div class="cookie-consent__category cookie-consent__category--collapsed" data-cookie-category>
                            <div class="cookie-consent__category-head">
                                <button type="button" class="cookie-consent__category-toggle" aria-expanded="false" aria-controls="cookie-consent-description-functional" data-cookie-accordion>
                                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18 15L12 9L6 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>                                    <span>Functional</span>
                                </button>

                                                                    <label class="cookie-consent__switch">
                                        
                                        <input type="checkbox" name="categories[]" value="functional"
                                               class="cookie-consent__switch-input"
                                               aria-label="Functional"
                                               >
                                        <span class="cookie-consent__switch-track">
                                            <span class="cookie-consent__switch-knob"></span>
                                        </span>
                                    </label>
                                                            </div>

                                                            <div id="cookie-consent-description-functional" class="cookie-consent__category-body">
                                    <div>
                                        <p class="cookie-consent__category-text">These cookies enable enhanced functionality and personalization, such as remembering user preferences and consent choices.</p>
                                    </div>
                                </div>
                                                    </div>
                                                                    <div class="cookie-consent__category cookie-consent__category--collapsed" data-cookie-category>
                            <div class="cookie-consent__category-head">
                                <button type="button" class="cookie-consent__category-toggle" aria-expanded="false" aria-controls="cookie-consent-description-analytics" data-cookie-accordion>
                                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18 15L12 9L6 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>                                    <span>Analytics</span>
                                </button>

                                                                    <label class="cookie-consent__switch">
                                        
                                        <input type="checkbox" name="categories[]" value="analytics"
                                               class="cookie-consent__switch-input"
                                               aria-label="Analytics"
                                               >
                                        <span class="cookie-consent__switch-track">
                                            <span class="cookie-consent__switch-knob"></span>
                                        </span>
                                    </label>
                                                            </div>

                                                            <div id="cookie-consent-description-analytics" class="cookie-consent__category-body">
                                    <div>
                                        <p class="cookie-consent__category-text">These cookies help us understand how visitors use our website, including pages viewed, traffic sources, actions taken and general location. This information is linked to a randomly generated identifier rather than to your name.</p>
                                    </div>
                                </div>
                                                    </div>
                                                                    <div class="cookie-consent__category cookie-consent__category--collapsed" data-cookie-category>
                            <div class="cookie-consent__category-head">
                                <button type="button" class="cookie-consent__category-toggle" aria-expanded="false" aria-controls="cookie-consent-description-advertising" data-cookie-accordion>
                                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18 15L12 9L6 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>                                    <span>Advertising</span>
                                </button>

                                                                    <label class="cookie-consent__switch">
                                        
                                        <input type="checkbox" name="categories[]" value="advertising"
                                               class="cookie-consent__switch-input"
                                               aria-label="Advertising"
                                               >
                                        <span class="cookie-consent__switch-track">
                                            <span class="cookie-consent__switch-knob"></span>
                                        </span>
                                    </label>
                                                            </div>

                                                            <div id="cookie-consent-description-advertising" class="cookie-consent__category-body">
                                    <div>
                                        <p class="cookie-consent__category-text">These cookies are used to measure the performance of our advertising and to show you relevant advertising on other websites. Information collected through them is made available to advertising providers including Google and LinkedIn.</p>
                                    </div>
                                </div>
                                                    </div>
                                    </form>
            </div>

            
            <div class="cookie-consent__actions">
                <form action="https://twelvedata.com/cookie-consent/accept-essentials" method="post" data-cookie-action="accept.essentials" class="cookiesBtn cookiesBtn--essentials">
    <input type="hidden" name="_token" value="EfrA6FvXpK577HtqRw5LI0uw1W8YbrJtJTVa7AWW" autocomplete="off">    <button type="submit" class="cookiesBtn__link">
        <span class="cookiesBtn__label">Reject all</span>
    </button>
</form>
                                    <form action="https://twelvedata.com/cookie-consent/accept-all" method="post" data-cookie-action="accept.all" class="cookiesBtn">
    <input type="hidden" name="_token" value="EfrA6FvXpK577HtqRw5LI0uw1W8YbrJtJTVa7AWW" autocomplete="off">    <button type="submit" class="cookiesBtn__link">
        <span class="cookiesBtn__label">Accept all</span>
    </button>
</form>
                                <div class="cookiesBtn">
                    <button type="submit" form="cookie-consent-configure" class="cookiesBtn__link">Save preferences</button>
                </div>
                            </div>
        </div>
    </div>
</aside>


